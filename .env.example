# ==============================================================================
# zjjjzx-watcher 环境变量示例配置文件 (Environment Variables Template)
# 复制本文件为 .env 并填入你自己的密钥：
# copy .env.example .env
# ==============================================================================

# 百度地图开放平台 AK（服务端类型应用，需开启「地理编码」与「批量算路(驾车)」服务权限）
# 获取地址：https://lbsyun.baidu.com/
BAIDU_MAP_AK=your_baidu_maps_ak_here

# DeepSeek API Key（用于对家教需求进行严格智能语义匹配）
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 可选：自定义 LLM Base URL 与模型名称（兼容 OpenAI 规范接口）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
